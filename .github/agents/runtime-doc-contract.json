{
  "version": 5,
  "implemented_workflow_engine": true,
  "engine_scope": "Local configuration/source workbench, scoped coding-assistant MCP, bounded direct inference and exact Gherkin handoff",
  "entrypoints": {
    "review": "story-orchestrator",
    "intake": "story-intake",
    "breakdown": "story-creator"
  },
  "waiting_states": [
    "captured",
    "awaiting_revision",
    "awaiting_decision",
    "awaiting_review"
  ],
  "terminal_states": [
    "exported",
    "rejected"
  ],
  "approval": {
    "required": true,
    "authentication": "revocable local role capability",
    "local_seal_implemented": true,
    "live_publisher_implemented": false,
    "max_ttl_seconds": 900
  },
  "storage": {
    "engine": "sqlite",
    "base_schema_version": 1,
    "refinement_schema_version": 1,
    "immutable": [
      "refine_records",
      "refine_exports"
    ],
    "automatic_deletion": false,
    "workspace_schema_version": 1,
    "encrypted_user_backups": true
  },
  "development_pipeline_integration": false,
  "model_orchestration_implemented": true,
  "model_orchestration_scope": "Explicit host-assistant task/result bridge or bounded draft/review calls, with optional intake and digest-bound targeted revision; no automatic extra stages",
  "all_ten_roles_automatically_dispatched": false,
  "canonical_acceptance_format": "gherkin",
  "quality_threshold_depends_on_user_expertise": false,
  "live_xray_validated": false,
  "assistant_bridge_implemented": true
}

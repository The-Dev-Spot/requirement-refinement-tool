{
  "version": 3,
  "implemented_workflow_engine": true,
  "engine_scope": "Durable local submissions, independent reviews, owner answers, approvals and sealed exports; not autonomous model invocation",
  "entrypoints": {
    "review": "story-orchestrator",
    "intake": "story-intake",
    "breakdown": "story-creator"
  },
  "waiting_states": [
    "awaiting_review",
    "awaiting_revision",
    "awaiting_po",
    "awaiting_approval"
  ],
  "approval_state": "approved",
  "quarantine_state": "quarantined",
  "terminal_states": [
    "exported",
    "rejected"
  ],
  "run_identity": "Stable run ID; imported source ID is immutable metadata",
  "approval": {
    "required": true,
    "authentication": "revocable local role capability",
    "local_seal_implemented": true,
    "live_publisher_implemented": false,
    "max_ttl_seconds": 900
  },
  "storage": {
    "engine": "sqlite",
    "schema_version": 1,
    "immutable": [
      "revisions",
      "reviews",
      "exports"
    ],
    "append_only": [
      "events"
    ],
    "automatic_deletion": false
  },
  "development_pipeline_integration": false,
  "model_orchestration_implemented": false
}

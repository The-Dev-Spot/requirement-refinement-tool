{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-dev-spot.invalid/clarity/schemas/requirement-acceptance-proposal-v1.schema.json",
  "title": "Clarity Requirement Acceptance Proposal v1 (untrusted, non-authorizing)",
  "description": "Data-only proposal: source.content_sha256 binds reviewed story JSON; canonical_content_sha256 independently binds original UTF-8 tracker description; tracker_revision is the authoritative tracker locator as supplied by a still-untrusted adapter. Never grants ACCEPTED.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "source",
    "handoff_sha256",
    "criterion_ids",
    "quality_report_sha256",
    "project_policy",
    "result",
    "reasons"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "clarity-requirement-acceptance-proposal"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "ref",
        "revision",
        "tracker_revision",
        "canonical_content_sha256",
        "content_sha256"
      ],
      "properties": {
        "system": {
          "type": "string",
          "enum": [
            "linear",
            "jira",
            "github",
            "local"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "tracker_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "canonical_content_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "handoff_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "criterion_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^AC-[0-9A-Za-z_.-]+$",
        "maxLength": 100
      }
    },
    "quality_report_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "project_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "result": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "NEEDS_DECISION",
        "BLOCKED"
      ]
    },
    "reasons": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
